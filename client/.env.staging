# Public values only (secrets never live in a Vite env file). Built with `--mode staging`.
VITE_BASE=/
VITE_SITE_URL=https://staging.pressstartgames.net
# The API origin; the client posts to <origin>/api/v1/waitlist.
VITE_SIGNUP_ENDPOINT=https://staging.pressstartgames.net
# Turnstile site key of the staging widget (public). Empty until the founder creates the widget.
VITE_TURNSTILE_SITE_KEY=
# Phase 4/5: staging GA4 measurement id and GrowthBook client key (public). Empty = off.
VITE_GA_MEASUREMENT_ID=
VITE_GROWTHBOOK_CLIENT_KEY=
