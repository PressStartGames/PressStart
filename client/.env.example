# Build-time variables (Vite reads VITE_*). None is required: with none set, the sign-up renders a
# static "coming soon" card and the site is otherwise complete.

# Vite's base path: "/" for a custom domain (public/CNAME), "/<repo>/" for a project page.
VITE_BASE=/
# The site's public URL, used for canonical links and the Worker's redirects.
VITE_SITE_URL=https://pressstartgames.github.io/PressStart

# Sign-up mode, in order of precedence:
#   1. VITE_SIGNUP_ENDPOINT = the Worker's origin (https://api.example.workers.dev) -> the real sign-up
#      VITE_SIGNUP_ENDPOINT = stub                                                  -> a local stub (dev, e2e)
#   2. VITE_SIGNUP_FALLBACK_URL = a form service's POST URL (Kit)                   -> a plain HTML form post
#   3. neither                                                                      -> "coming soon" card
VITE_SIGNUP_ENDPOINT=
VITE_SIGNUP_FALLBACK_URL=
# Turnstile site key (public). Only used with a real endpoint.
VITE_TURNSTILE_SITE_KEY=
