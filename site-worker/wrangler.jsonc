// The site Worker (plans/main-site.md Phase 6): serves client/dist (the main site at /, the beta at
// /beta/*) from Workers static assets. With no experiments configured it is pure static serving:
// Cloudflare answers every asset request itself and the script in src/worker.ts is never invoked for a
// hit (run_worker_first is false). Unknown paths get the nearest 404.html (/x -> 404.html,
// /beta/x -> beta/404.html), which prerender.ts emits.
//
// The TOP LEVEL is local (`pnpm --filter site-worker dev`, port 8791): no routes. Deploys always name an
// environment: `deploy:staging` / `deploy:production`, or the workflows in .github/workflows/.
// Build the matching client first: `pnpm --filter client build --mode staging|production`.
//
// Routes: the API Worker owns `<host>/api/v1/*` (server/wrangler.toml); Cloudflare picks the most
// specific route, so the site Worker `<host>/*` never shadows it. Each host needs a proxied
// (orange-cloud) DNS record or the route never fires.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "press-start-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // EDGE INTEGRATION (Phase 4/5): when edge/experiments.ts exists, list its route patterns here, e.g.
    // "run_worker_first": ["/", "/engine/*"], and see src/worker.ts for the three-line wiring. Until
    // then the Worker is not invoked for assets at all.
    "run_worker_first": false,
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "press-start-site-staging",
      "main": "src/worker.ts",
      "assets": {
        "directory": "../client/dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        // Staging runs the Worker for every request so it can add `X-Robots-Tag: noindex` (the build is
        // the production build; only this header differs). Production stays static-only.
        "run_worker_first": true,
      },
      "vars": { "ROBOTS_NOINDEX": "true" },
      "routes": [
        { "pattern": "staging.pressstartgames.net/*", "zone_name": "pressstartgames.net" },
      ],
      "workers_dev": false,
      // PR previews: `wrangler versions upload` returns a <version>-press-start-site-staging.<subdomain>.workers.dev
      // URL when preview URLs are on.
      "preview_urls": true,
      "observability": { "enabled": true },
    },
    "production": {
      "name": "press-start-site",
      "main": "src/worker.ts",
      "assets": {
        "directory": "../client/dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        "run_worker_first": false,
      },
      // Phase 7 step 3: this route is what puts the new site on the root. It is deployed only by the
      // approval-gated production job.
      "routes": [{ "pattern": "pressstartgames.net/*", "zone_name": "pressstartgames.net" }],
      "workers_dev": false,
      "observability": { "enabled": true },
    },
  },
}
