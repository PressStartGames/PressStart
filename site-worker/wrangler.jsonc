// The site Worker (plans/main-site.md Phase 6): serves client/dist (the main site at /, the beta at
// /beta/*) from Workers static assets. Cloudflare answers asset requests itself; the script in src/worker.ts
// runs only where run_worker_first says: the edge's routes ("/", edge/config.ts WORKER_FIRST_ROUTES) so the
// home headline can be an experiment, and every request on staging (the noindex header). Without a GrowthBook
// key, or without the visitor's consent cookie, "/" is the plain static page. Unknown paths get the nearest
// 404.html (/x -> 404.html, /beta/x -> beta/404.html), which prerender.ts emits.
//
// The TOP LEVEL is local (`pnpm --filter site-worker dev`, port 8791): no routes. Deploys always name an
// environment: `deploy:staging` / `deploy:production`, or the workflows in .github/workflows/.
// Build the matching client first: `pnpm --filter client build --mode staging|production`.
//
// Routes: the API Worker owns `<host>/api/v1/*` (server/wrangler.toml); Cloudflare picks the most
// specific route, so the site Worker `<host>/*` never shadows it. Each host needs a proxied
// (orange-cloud) DNS record or the route never fires.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "press-start-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Local: only the edge's routes (edge/config.ts WORKER_FIRST_ROUTES) wake the Worker.
    "run_worker_first": ["/"],
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "press-start-site-staging",
      "main": "src/worker.ts",
      "assets": {
        "directory": "../client/dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        // Staging runs the Worker for every request so it can add `X-Robots-Tag: noindex` (the build is
        // the production build; only this header differs). The edge handler passes every route that has no
        // experiment straight to the assets, so this is a superset of WORKER_FIRST_ROUTES.
        "run_worker_first": true,
      },
      // GROWTHBOOK_*: the SDK connection's client key (public) for the edge experiments. Empty = no experiment is live
      // and `/` is the static control page. The founder supplies the key (plans/main-site.md Phase 5).
      "vars": { "ROBOTS_NOINDEX": "true", "GROWTHBOOK_CLIENT_KEY": "", "GROWTHBOOK_API_HOST": "" },
      "routes": [
        // A custom domain: Cloudflare creates the DNS record itself (the deploy login cannot edit DNS).
        { "pattern": "staging.pressstartgames.net", "custom_domain": true },
      ],
      "workers_dev": false,
      // PR previews: `wrangler versions upload` returns a <version>-press-start-site-staging.<subdomain>.workers.dev
      // URL when preview URLs are on.
      "preview_urls": true,
      "observability": { "enabled": true },
    },
    "production": {
      "name": "press-start-site",
      "main": "src/worker.ts",
      "assets": {
        "directory": "../client/dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        // Only the edge's routes (edge/config.ts WORKER_FIRST_ROUTES); everything else is static.
        "run_worker_first": ["/"],
      },
      "vars": { "GROWTHBOOK_CLIENT_KEY": "", "GROWTHBOOK_API_HOST": "" },
      // Phase 7 step 3: this route is what puts the new site on the root. It is deployed only by the
      // approval-gated production job.
      "routes": [{ "pattern": "pressstartgames.net/*", "zone_name": "pressstartgames.net" }],
      "workers_dev": false,
      "observability": { "enabled": true },
    },
  },
}
